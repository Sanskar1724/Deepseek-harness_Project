# Application
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=landslide-ner

# API
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# Database (SQLite + SpatiaLite)
DATABASE_URL=sqlite:///./landslide.db
SPATIALITE_PATH=mod_spatialite

# CORS
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# =================================================================
# Provider selection — FREE real options that need NO API key:
# =================================================================
# Weather:  mock | open_meteo
# Rainfall: mock | open_meteo
# Terrain:  mock | nasa_power | open_elevation
# Soil:     mock | nasa_power
# Satellite: mock (no free real option implemented yet)
# Landslide: mock (use NASA COOLR loader via --loader nasa_coolr)
# =================================================================
WEATHER_PROVIDER=open_meteo
RAINFALL_PROVIDER=open_meteo
TERRAIN_PROVIDER=open_elevation
SATELLITE_PROVIDER=mock
LANDSLIDE_PROVIDER=mock
SOIL_PROVIDER=nasa_power

# =================================================================
# API keys (only needed for providers that require auth)
# =================================================================
OPENWEATHER_API_KEY=
BHUVAN_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# =================================================================
# Risk engine thresholds (0-100 score)
# =================================================================
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MODERATE=60
RISK_THRESHOLD_HIGH=80

# =================================================================
# Alert delivery
# =================================================================
ALERT_PROVIDER=log
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=NER-ALERT

# =================================================================
# i18n
# =================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,as
